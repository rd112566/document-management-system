# ========================================================
# Azure OpenAI GPT Model Deployment Configuration
# ========================================================
# Your Azure OpenAI Service endpoint (from Azure Portal > Keys & Endpoint)
# Format: https://<your-resource-name>.openai.azure.com/
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/

# Your Azure OpenAI API key (Key 1 or Key 2)
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here

# The deployment name of your GPT model created in Azure OpenAI Studio (e.g. gpt-4o, gpt-4o-mini, gpt-4, gpt-35-turbo)
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o

# Azure OpenAI API version (e.g., 2024-08-01-preview, 2024-02-15-preview, 2024-06-01)
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Optional: Azure OpenAI Text Embedding deployment name (e.g., text-embedding-3-small)
# Leave blank to use ChromaDB's high-speed local ONNX embeddings
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# JWT Authentication Secret Key (change for production)
JWT_SECRET=super-secret-rag-dms-key-2026-very-secure
